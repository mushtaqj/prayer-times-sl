{
  "name": "prayer-times-functions",
  "description": "Firebase Cloud Functions for Prayer Times push notifications",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "copy-data": "mkdir -p data && cp ../src/data/prayerTimes.json data/"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "type": "module",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "firebase-functions-test": "^3.2.0"
  },
  "private": true
}
