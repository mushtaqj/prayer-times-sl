# ===========================================
# Prayer Times App - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# ===========================================
# ADMIN AUTHENTICATION
# ===========================================

# Secret password for admin access (used for login and token signing)
# Generate a strong random string: openssl rand -hex 32
ADMIN_SECRET=your-secure-admin-password-here

# Comma-separated list of email addresses authorized to access admin
AUTHORIZED_EMAILS=admin@example.com,another-admin@example.com

# ===========================================
# EMAIL SERVICE (Resend)
# ===========================================

# Resend API key for sending confirmation emails
# Get your API key at: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxx

# Optional: Custom sender email address
# Default: "Prayer Times <noreply@resend.dev>"
# Note: You need a verified domain in Resend to use custom addresses
# EMAIL_FROM=Prayer Times <noreply@yourdomain.com>

# ===========================================
# GITHUB INTEGRATION
# ===========================================

# GitHub Personal Access Token with repo and workflow permissions
# Create at: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub repository in format "owner/repo"
GITHUB_REPO=your-username/prayer-times-app

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Base URL for the app (optional - Vercel sets this automatically)
# Only needed for local development or non-Vercel deployments
# BASE_URL=http://localhost:3000
